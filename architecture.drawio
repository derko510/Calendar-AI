<mxfile host="app.diagrams.net" type="device">
  <diagram id="calendar-ai-architecture" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Calendar-AI — System Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;React SPA + stateless Express API on Vercel · tool-calling agent on Groq · Google Calendar is the only data store&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="60" as="geometry" />
        </mxCell>

        <mxCell id="user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="40" height="80" as="geometry" />
        </mxCell>

        <mxCell id="vercel" value="Vercel (single project: client/)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="170" y="110" width="800" height="480" as="geometry" />
        </mxCell>

        <!-- Frontend -->
        <mxCell id="fe" value="Frontend — React (Vite) SPA&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;holds the Google token and the user's events&lt;/font&gt;" style="swimlane;html=1;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="200" y="160" width="300" height="400" as="geometry" />
        </mxCell>
        <mxCell id="fe_bot" value="RealCalendarBot.jsx (Ask panel)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sends message + events + time zone; shows answers, event cards, confirm buttons&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="fe">
          <mxGeometry x="20" y="55" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fe_signin" value="SignIn.jsx&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;@react-oauth/google → access token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="fe">
          <mxGeometry x="20" y="140" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe_gcal" value="services/googleCalendar.js&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;list / create / delete with the user's token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="fe">
          <mxGeometry x="20" y="205" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe_dash" value="Dashboard.jsx&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Month / Week / Day views&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="fe">
          <mxGeometry x="20" y="270" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe_confirm" value="&lt;font style=&quot;font-size:10px&quot;&gt;Create / delete only happen here, after the user clicks Confirm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;dashed=1;" vertex="1" parent="fe">
          <mxGeometry x="20" y="335" width="260" height="45" as="geometry" />
        </mxCell>

        <!-- Backend -->
        <mxCell id="be" value="Backend — api/index.js (Express, serverless)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;stateless: no database, no sessions&lt;/font&gt;" style="swimlane;html=1;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="540" y="160" width="400" height="400" as="geometry" />
        </mxCell>
        <mxCell id="be_route" value="POST /api/assistant/message&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;routes/assistant.js · validates input, logs latency + tokens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="be">
          <mxGeometry x="20" y="60" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be_index" value="assistant/index.js — runAssistant()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;picks the engine (ASSISTANT_ENGINE); `now` is injectable for evals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="be">
          <mxGeometry x="20" y="125" width="360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="be_agent" value="&lt;b&gt;agent.js&lt;/b&gt; (default)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tool loop, ≤ 5 steps:&lt;br&gt;search_events → answer | create_events | delete_events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="be">
          <mxGeometry x="20" y="190" width="200" height="85" as="geometry" />
        </mxCell>
        <mxCell id="be_prompt" value="promptEngine.js&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;baselines v0 / v1: every event pasted into one prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;" vertex="1" parent="be">
          <mxGeometry x="235" y="190" width="145" height="85" as="geometry" />
        </mxCell>
        <mxCell id="be_events" value="events.js + time.js&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;deterministic: search, past/now/upcoming, time zones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="be">
          <mxGeometry x="20" y="295" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="be_llm" value="services/llm.js&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Groq client, retries, usage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="be">
          <mxGeometry x="235" y="295" width="145" height="55" as="geometry" />
        </mxCell>

        <!-- External -->
        <mxCell id="groq" value="Groq API&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Llama, OpenAI-compatible tool calling&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="452" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="evals" value="&lt;b&gt;evals/&lt;/b&gt; (npm run eval)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fixed fake calendar + frozen &quot;now&quot;&lt;br&gt;~35 cases → accuracy per category&lt;br&gt;for each engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="250" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tests" value="&lt;b&gt;server/test/&lt;/b&gt; (npm test)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;unit tests, fake LLM, runs in CI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="360" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="google_id" value="Google Identity&lt;br&gt;(OAuth 2.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="640" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="google_cal" value="Google Calendar API&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the only data store&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="640" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="flow" value="&lt;b&gt;One chat message&lt;/b&gt;&lt;br&gt;1. Browser signs in with Google and loads events straight from Google Calendar.&lt;br&gt;2. User asks &quot;When was my last dentist appointment?&quot; → POST /api/assistant/message with the message, the events and the time zone.&lt;br&gt;3. The agent calls search_events({ keywords: [&quot;dentist&quot;,&quot;dental&quot;], status: &quot;past&quot;, order: &quot;desc&quot; }); code filters and returns only the matches.&lt;br&gt;4. The agent finishes with answer({ text, eventIds }); ids are checked against what search returned, so cards always match the text.&lt;br&gt;5. For create / delete the agent only proposes; the browser asks the user to confirm, then calls Google Calendar itself." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="620" width="680" height="120" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_user" value="uses" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="user" target="fe"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_msg" value="2. message, events, timeZone" style="endArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fe_bot" target="be_route"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_route_index" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="be_route" target="be_index"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_index_agent" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="be_index" target="be_agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_index_prompt" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;dashed=1;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="be_index" target="be_prompt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_agent_events" value="3. search" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#82b366;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="be_agent" target="be_events"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_agent_llm" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=1;exitY=0.85;entryX=0.2;entryY=0;" edge="1" parent="1" source="be_agent" target="be_llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_prompt_llm" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;dashed=1;exitX=0.6;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="be_prompt" target="be_llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_llm_groq" value="chat + tools" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#b85450;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="be_llm" target="groq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_evals" value="same code path" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#9673a6;labelBackgroundColor=#ffffff;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="evals" target="be_index"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_signin" value="1. sign in" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#d6b656;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.2333;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fe" target="google_id"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_gcal" value="1. load · 5. create / delete" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#d6b656;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.7667;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fe" target="google_cal"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

<mxfile host="app.diagrams.net" type="device">
  <diagram id="calendar-ai-architecture" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Calendar-AI — System Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;React SPA + stateless Express API on Vercel · tool-calling agent · owner: Claude Haiku (Groq backup), everyone else: Groq free tier · Google Calendar is the only data store&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="397" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="vercel" value="Vercel (single project: client/)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="170" y="110" width="830" height="635" as="geometry" />
        </mxCell>
        <mxCell id="fe" value="Frontend — React (Vite) SPA&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;holds the 1-hour Google token in memory and the user's events&lt;/font&gt;" style="swimlane;html=1;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="200" y="160" width="300" height="555" as="geometry" />
        </mxCell>
        <mxCell id="fe_bot" value="RealCalendarBot.jsx (Ask panel)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sends message + events + time zone; shows answers, cards, confirm buttons&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="fe">
          <mxGeometry x="20" y="50" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fe_gcal" value="services/googleCalendar.js&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;list / create / delete with the user's token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="fe">
          <mxGeometry x="20" y="150" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe_dash" value="Dashboard.jsx&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Month / Week / Day views; /?demo uses sample data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="fe">
          <mxGeometry x="20" y="250" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe_confirm" value="&lt;font style=&quot;font-size:10px&quot;&gt;Create / delete only happen here, after the user clicks Confirm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;dashed=1;" vertex="1" parent="fe">
          <mxGeometry x="20" y="385" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fe_signin" value="SignIn.jsx&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Google sign-in popup → auth code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="fe">
          <mxGeometry x="20" y="490" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="be" value="Backend — api/index.js (Express, serverless)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;stateless: no database; one encrypted sign-in cookie&lt;/font&gt;" style="swimlane;html=1;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="580" y="160" width="400" height="555" as="geometry" />
        </mxCell>
        <mxCell id="be_route" value="POST /api/assistant/message&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;routes/assistant.js · validates input, logs latency + tokens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="be">
          <mxGeometry x="20" y="55" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be_gate" value="sign-in gate — requireUser&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;owner → Claude Haiku · everyone else + demo → Groq (rate limited)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="be">
          <mxGeometry x="20" y="125" width="360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="be_index" value="assistant/index.js — runAssistant()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;picks the engine (ASSISTANT_ENGINE); `now` is injectable for evals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="be">
          <mxGeometry x="20" y="190" width="360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="be_agent" value="&lt;b&gt;agent.js&lt;/b&gt; (default)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tool loop, ≤ 5 steps:&lt;br&gt;search_events → answer | create_events | delete_events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="be">
          <mxGeometry x="20" y="255" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="be_prompt" value="promptEngine.js&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;baselines v0 / v1: every event in one prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;" vertex="1" parent="be">
          <mxGeometry x="210" y="255" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="be_events" value="events.js + time.js&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;deterministic: search, status, time zones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="be">
          <mxGeometry x="20" y="375" width="110" height="100" as="geometry" />
        </mxCell>
        <mxCell id="be_llm" value="AI client — services/llm.js&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;owner: Claude → Groq backup&lt;br&gt;public: Groq only&lt;br&gt;retries, usage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="be">
          <mxGeometry x="145" y="375" width="235" height="100" as="geometry" />
        </mxCell>
        <mxCell id="be_auth" value="/api/auth&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;code exchange, refresh, logout (AES-256-GCM cookie)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="be">
          <mxGeometry x="20" y="490" width="360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="groq" value="Groq (free tier)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;openai/gpt-oss-120b → 20b, tool calling&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="535" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="claude" value="Claude Haiku 5.5&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;owners' primary model, paid (~$0.0004/msg)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="600" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="evals" value="&lt;b&gt;evals/&lt;/b&gt; (npm run eval)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fixed fake calendar + frozen &quot;now&quot;&lt;br&gt;37 base cases + extended suite&lt;br&gt;accuracy per category, per engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="325" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tests" value="&lt;b&gt;server/test/&lt;/b&gt; (npm test)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;unit + API tests, fake LLM, runs in CI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="440" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="google_cal" value="Google Calendar API&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the only data store&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="790" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="google_id" value="Google Identity (OAuth 2.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="790" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flow" value="&lt;b&gt;One chat message&lt;/b&gt;&lt;br&gt;1. Sign in: Google popup → one-time code → POST /api/auth/google swaps it for a refresh token kept in an encrypted httpOnly cookie; the page gets a 1-hour access token and loads events straight from Google Calendar.&lt;br&gt;2. User asks &quot;When was my last dentist appointment?&quot; → POST /api/assistant/message with the message, the events and the time zone (cookie attached).&lt;br&gt;3. The sign-in gate checks the cookie: owner → Claude Haiku (Groq backup); any other account or the demo → Groq only, rate limited.&lt;br&gt;4. The agent calls search_events({ keywords: [&quot;dentist&quot;,&quot;dental&quot;], status: &quot;past&quot;, order: &quot;desc&quot; }); code filters and returns only the matches.&lt;br&gt;5. The agent finishes with answer({ text, eventIds }); ids are checked against what search returned, so cards always match the text.&lt;br&gt;6. For create / delete the agent only proposes; the browser asks the user to confirm, then calls Google Calendar itself." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="1220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_user" value="uses" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="user" target="fe"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_msg" value="2. message" style="endArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fe_bot" target="be_route"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_route_gate" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="be_route" target="be_gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_gate_index" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="be_gate" target="be_index"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_index_agent" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=0.2361;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="be_index" target="be_agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_index_prompt" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;dashed=1;exitX=0.7639;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="be_index" target="be_prompt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_agent_events" value="4. search" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#82b366;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.3235;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="be_agent" target="be_events"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_agent_llm" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=0.8824;exitY=1;entryX=0.1064;entryY=0;" edge="1" parent="1" source="be_agent" target="be_llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_prompt_llm" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;dashed=1;exitX=0.5;exitY=1;entryX=0.6383;entryY=0;" edge="1" parent="1" source="be_prompt" target="be_llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_llm_groq" value="chat + tools" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#b85450;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="be_llm" target="groq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_llm_claude" value="owners" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#b85450;dashed=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="be_llm" target="claude"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_evals" value="same code" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#9673a6;labelBackgroundColor=#ffffff;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="evals" target="be_index"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_signin_auth" value="1. code" style="endArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fe_signin" target="be_auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_signin" value="1. popup" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#d6b656;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.8;exitY=1;entryX=0.1333;entryY=0;" edge="1" parent="1" source="fe" target="google_id"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_gcal" value="1. load · 6. create / delete" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#d6b656;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.2333;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fe" target="google_cal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_auth_google" value="code → tokens" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#d6b656;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.1667;exitY=1;entryX=0.8667;entryY=0;" edge="1" parent="1" source="be_auth" target="google_id"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

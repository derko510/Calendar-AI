# Copy to client/.env and fill in. One file for both the app and the API.
# Check it with: npm run check-env
# Only VITE_* values and GOOGLE_CLIENT_ID reach the browser; everything else stays on the server.

# --- Browser ---
# VITE_API_URL=   (leave unset: the API is on the same domain)

# --- Server: AI (required for the chat) — free key at https://console.groq.com/keys ---
GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=openai/gpt-oss-20b   (or openai/gpt-oss-120b for better answers)

# --- Server: Google OAuth — https://console.cloud.google.com/apis/credentials ---
# GOOGLE_CLIENT_ID is also used by the browser for sign-in (it's public)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# --- Server: secrets (generate each with: openssl rand -hex 32) ---
SESSION_SECRET=change_me
JWT_SECRET=change_me

# --- Server: optional Postgres (e.g. Neon). Without it, synced events are kept in memory ---
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Local dev ---
PORT=3001
FRONTEND_URL=http://localhost:5173

# Copy to client/.env and fill in. One file for both the app and the API.
# Check it with: npm run check-env
# Only VITE_* values are sent to the browser; everything else stays on the server.

# --- Google sign-in (the browser talks to Google Calendar directly) ---
# Create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
# (authorized JavaScript origins: http://localhost:5173, http://127.0.0.1:5173 and your production URL).
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# VITE_API_URL=   (leave unset: the API is on the same domain)

# --- Server: keeps you signed in for months (refresh token in an encrypted cookie) ---
# Same value as VITE_GOOGLE_CLIENT_ID (falls back to it if unset)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# The client secret of that same OAuth client. Server only: never prefix it with VITE_
GOOGLE_CLIENT_SECRET=your_client_secret
# 32+ random characters; encrypts the sign-in cookie. Changing it signs everyone out.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace_with_at_least_32_random_characters

# --- Server: who may use the AI chat (every message spends your AI key) ---
# Comma-separated Google accounts allowed to sign in and chat. Unset = anyone who can sign in.
# ALLOWED_EMAILS=you@example.com
# true = the public demo (/?demo) can chat without signing in, on your key. Off by default.
# DEMO_CHAT_ENABLED=false

# --- Server: AI (at least one key is required for the chat) ---
# With both keys, every message starts on Groq (free) and switches to Claude (paid) only when Groq is rate limited.
# With one key, that provider is used alone. LLM_PROVIDER=groq|anthropic forces one.

# Groq, the primary. Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=openai/gpt-oss-20b

# Claude, the backup. Key: https://console.anthropic.com/settings/keys
# The model is fixed in code to claude-haiku-5-5 (cheapest), so there is no model setting.
ANTHROPIC_API_KEY=sk-ant-your_key_here
# Only if your key is NOT created inside a workspace (Console → Settings → Workspaces → copy the ID):
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# ANTHROPIC_EFFORT=low               (low | medium | high: how much the model thinks)
# LLM_PROVIDER=groq
# Which assistant engine answers: agent | prompt-v1 | prompt-v0 (default: agent)
# ASSISTANT_ENGINE=agent

# --- Local dev ---
PORT=3001
